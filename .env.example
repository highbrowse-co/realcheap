# Cover Genius XCover sandbox — see docs/DECISIONS.md for how these are used.
# Server-side only. Never reference these in /web code (see CLAUDE.md hard constraint 1).
#
# Only needed for MOCK_MODE=false (live mode) — MOCK_MODE=true (the default) doesn't
# read these at all (server/src/config.ts). This file isn't required to run the app;
# a fresh clone with no .env at all still works in MOCK_MODE.

XCOVER_API_DOMAIN=https://api.xcover-staging.com
XCOVER_BASE_PATH=/xcover/partners/
# Partner-specific: this is the sandbox account this project was built against.
# Replace with your own partner code if you're using different XCover credentials.
XCOVER_PARTNER_CODE=E3CCM
XCOVER_API_KEY=your-api-key-here
XCOVER_API_SECRET=your-api-secret-here

# When true, the server proxy serves fixture responses from /fixtures instead of
# calling XCover. Must be an env change only — never a code change (hard constraint 4).
MOCK_MODE=true

PORT=3001
