      "item": [
        {
          "name": "Confirm Offer (with x-idempotency-key)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-idempotency-key", "value": "{{idempotency_key}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quotes\": [ { \"id\": \"{{quote_id}}\" } ],\n  \"policyholder\": {\n    \"first_name\": \"{{policyholder_first_name}}\",\n    \"last_name\": \"{{policyholder_last_name}}\",\n    \"email\": \"{{policyholder_email}}\",\n    \"phone\": \"{{policyholder_phone}}\",\n    \"country\": \"{{market_country}}\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{xcover_domain}}{{xcover_base_path}}{{xcover_partner_code}}/offers/{{offer_id}}/confirm/",
              "host": ["{{xcover_domain}}{{xcover_base_path}}{{xcover_partner_code}}"],
              "path": ["offers", "{{offer_id}}", "confirm", ""]
            },
            "description": "Run Create Offer first for a fresh offer_id/quote_id. Sets a fresh {{idempotency_key}} for this run and confirms with it. Per docs/API-NOTES.md / offers/api/idempotency-keys.md: the response body is cached against this key for 48 hours. Compare against the next request in this folder, which resends the identical key+body."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A fresh key per Runner iteration/manual run — Postman's built-in {{$guid}} dynamic variable.",
                  "pm.environment.set('idempotency_key', pm.variables.replaceIn('realcheap-{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 (first confirm)', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('booking_id', body.id);",
                  "  console.log('booking_id ->', body.id, ' idempotency_key ->', pm.environment.get('idempotency_key'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Repeat Confirm (same key+body) -> 409 cached result",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-idempotency-key", "value": "{{idempotency_key}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quotes\": [ { \"id\": \"{{quote_id}}\" } ],\n  \"policyholder\": {\n    \"first_name\": \"{{policyholder_first_name}}\",\n    \"last_name\": \"{{policyholder_last_name}}\",\n    \"email\": \"{{policyholder_email}}\",\n    \"phone\": \"{{policyholder_phone}}\",\n    \"country\": \"{{market_country}}\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{xcover_domain}}{{xcover_base_path}}{{xcover_partner_code}}/offers/{{offer_id}}/confirm/",
              "host": ["{{xcover_domain}}{{xcover_base_path}}{{xcover_partner_code}}"],
              "path": ["offers", "{{offer_id}}", "confirm", ""]
            },
            "description": "Must run immediately after 'Confirm Offer (with x-idempotency-key)' in the same session, unchanged, so offer_id/quote_id/idempotency_key are identical. Real captured behavior (fixtures/probe/idempotency-key-repeat.json): 409 Conflict, body is the SAME booking as the first call (same booking id), not a new booking and not the 'Booking already exists' 422 seen without the header (docs/API-NOTES.md). Per Cover Genius's docs this 409 is meant to be treated as a successful response by the client — it's the safe double-click/retry path, unlike confirming without an idempotency key."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
