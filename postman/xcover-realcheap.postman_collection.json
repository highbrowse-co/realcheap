        {
          "name": "Create Offer with bad signature -> 403",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": { \"currency\": \"{{market_currency}}\", \"language\": \"{{market_language}}\", \"country\": \"{{market_country}}\" },\n  \"partner\": {},\n  \"context\": {\n    \"purchase_date\": \"{{purchase_date}}\",\n    \"product\": { \"retail_value\": {{retail_value}}, \"quantity\": {{quantity}} }\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{xcover_domain}}{{xcover_base_path}}{{xcover_partner_code}}/offers/",
              "host": ["{{xcover_domain}}{{xcover_base_path}}{{xcover_partner_code}}"],
              "path": ["offers", ""]
            },
            "description": "Request-level pre-request script re-signs with a deliberately wrong secret, overriding the collection-level signature. Real captured response: 403 { \"type\": \"auth_error\", \"message\": \"You do not have permission to access this url\" }. See fixtures/probe/err-bad-signature.json."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Overrides the collection-level Authorization header with a signature",
                  "// computed from a wrong secret, to demonstrate the bad-signature error shape.",
                  "const date = new Date().toUTCString();",
                  "const apiKey = pm.environment.get('xcover_api_key');",
                  "const wrongSecret = 'this-is-not-the-real-secret';",
                  "const digest = CryptoJS.HmacSHA512(`date: ${date}`, wrongSecret).toString(CryptoJS.enc.Base64);",
                  "const signature = encodeURIComponent(digest);",
                  "pm.request.headers.upsert({ key: 'Date', value: date });",
                  "pm.request.headers.upsert({",
                  "  key: 'Authorization',",
                  "  value: `Signature keyId=\"${apiKey}\",algorithm=\"hmac-sha512\",signature=\"${signature}\"`",
                  "});"
                ]
              }
            }
          ]
        }
